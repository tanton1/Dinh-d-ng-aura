{
  "name": "aura-fitness-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc -b",
    "build": "tsc -b && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "nutrition:index": "node scripts/build-nutrition-client-index.mjs",
    "build:gh-pages": "tsc -b && vite build --base /aura-fitness-elearning-/ && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "deploy:gh-pages": "npm run build:gh-pages && npx --yes gh-pages -d dist -r https://github.com/tanton1/aura-fitness-elearning-.git",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aura-fitness \"node --test tests/firestore.rules.test.mjs\"",
    "typecheck": "tsc -b",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.16.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^14.2.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
