# Firebase Functions runtime parameters. Keep true only after the web App Check
# provider is registered and VITE_FIREBASE_APP_CHECK_SITE_KEY is in Vercel.
ENFORCE_APP_CHECK=false
PUBLIC_APP_URL=https://dinh-duong-aura.vercel.app
OPENROUTER_TEXT_MODEL=google/gemini-3.7-flash
OPENROUTER_TEXT_FALLBACK_MODEL=google/gemini-3.6-flash
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
OPENROUTER_VISION_FALLBACK_MODEL=google/gemini-3.6-flash
