# Firebase Functions runtime parameters. Keep broad callable enforcement false
# during the AI-only rollout so Auth-adjacent, Push and product callables remain
# compatible. Enable the AI flag only after the web provider is registered,
# VITE_FIREBASE_APP_CHECK_SITE_KEY is deployed to Vercel production, and
# production telemetry reports valid App Check tokens.
ENFORCE_APP_CHECK=false
ENFORCE_AI_APP_CHECK=false
PUBLIC_APP_URL=https://dinh-duong-aura.vercel.app
OPENROUTER_TEXT_MODEL=google/gemini-3.7-flash
OPENROUTER_TEXT_FALLBACK_MODEL=google/gemini-3.6-flash
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
OPENROUTER_VISION_FALLBACK_MODEL=google/gemini-3.6-flash
