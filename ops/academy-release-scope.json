  "invariants": [
    "No full Functions fleet deployment, no region migration, no warm-instance increase, no SMS enablement.",
    "No automatic content migration, publication or scientific reviewer grant.",
    "Preserve published snapshots, progress, workbook archives, immutable submissions and existing private keys.",
    "Keep unrelated dirty work out of the archive; never stage, commit or push the shared workspace.",
    "Function scope must match direct and transitive dependency audit, including regional aliases. No PT endpoint is part of this release."
  ],
  "sequence": [
    {
      "id": "source-verification",
      "requires": [
        "Frozen source checksums and private-marker scan",
        "Academy logic, browser, Rules and real emulator transaction suites from isolated source",
        "Production configuration validation using protected deployment environment; never compile [SENSITIVE] placeholders"
      ],
      "pending": [
        "Isolated-source verification",
        "Production configuration and authenticated smoke account"
      ]
    },
    {
      "id": "guardrails-first",
      "requires": [
        "Capture current serving revisions and previous deployed Rules/index policies",
        "Coordinate authoring pause until all runtime endpoints and frontend are verified",
        "Apply named-database Firestore Rules and immutable Storage Rules before new private grading/submission data is written",
        "Apply only the 16 reviewed single-field exemptions; do not delete or replace unrelated indexes"
      ],
      "pending": [
        "Reviewed targeted field-exemption deployment path; existing index helper handles composites only",
        "Deployed permission verification"
      ]
    },
    {
      "id": "runtime-before-authoring",
      "requires": [
        "Deploy explicit runtime functions sequentially in recorded regions",
        "Verify health, exact serving revision, unchanged/zero warm reservations, no missing IAM invoker permission and old-client legacy-course access",
        "Do not invoke mutation smoke tests against real learner evidence"
      ]
    },
    {
      "id": "authoring-last",
      "requires": [
        "Every selected-delivery, lifecycle, grading, media and workout endpoint supports chapters-v1",
        "Deploy the three authoring mutators last while content editing is paused",
        "Do not run legacy direct-publish scripts"
      ]
    },
    {
      "id": "frontend",
      "requires": [
        "Backend and Rules verification completed",
        "Build from the isolated reviewed revision with protected Vercel environment; pin exact release identifier",
        "Verify authenticated learner/coach/staff boundaries and active public alias before ending authoring pause"
      ],
      "pending": [
        "Release orchestration that prevents Vercel Git auto-promotion before backend completion; current general workflow is not a sufficient ordering barrier"
      ]
    },
    {
      "id": "content-after-human-review",
      "requires": [
        "A named qualified reviewer and scoped verified grant, provisioned separately by an authorized administrator",
        "Explicit review of each immutable chapter candidate; approval is not inferred from passing tests",
        "One-chapter pilot adoption into draft, preview and explicit publication, then staged expansion",
        "Measure real read requests/document reads, load latency, error rate and learner evidence before expanding"
      ],
      "pending": [
        "Qualified scientific reviewer and approval",
        "Real approved adoption/publication and production measurements"
      ]
    }
  ],
  "rollback": [
    "Before any chapters-v1 write, revert only the affected runtime to its captured verified serving revision if its source/config and permission compatibility are known; a local HEAD tar is not proof of production rollback safety.",
    "After any chapters-v1 migration or immutable-submission write, do not return to legacy-only readers/writers or restore raw root documents. Keep the storage-aware backend and privacy Rules; prefer forward repair.",
    "Frontend rollback must target a verified storage-aware compatible build. Retain published content snapshots and all learner evidence.",
    "Content rollback uses the audited restore-to-draft/review/publication workflow for an eligible reviewed revision. For the first reviewed publication with no approved prior version, archive the course if needed and repair forward; never bypass scientific review.",
    "No automatic deletion of the newly introduced callable or any private chapter/submission data."
  ],
  "prohibitedCommands": [
    "firebase deploy --only functions",
    "scripts/release-aura-nutrition-learning-v2.cjs --mode=apply",
    "scripts/release-aura-nutrition-study-guides.cjs --mode=apply",
    "Raw Firestore updates that bypass reviewed adoption/publication"
  ],
  "workflowAudit": {
    "currentGeneralWorkflow": ".github/workflows/release-production.yml",
    "limitations": [
      "Current workflow applies Rules after backend deployment.",
      "It waits for a Vercel Git deployment instead of controlling when the public frontend alias is promoted.",
      "Its index helper creates missing composite indexes but does not deploy these single-field exemptions."
    ],
    "useForThisRelease": "Do not dispatch unchanged; resolve the ordering and index gaps first."
  },
