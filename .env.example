# Keep broad callable enforcement disabled during the AI-only rollout.
ENFORCE_APP_CHECK=false
# Protect only paid AI callables after production App Check traffic is VALID.
ENFORCE_AI_APP_CHECK=false
PUBLIC_APP_URL=https://dinh-duong-aura.vercel.app
VITE_AUTH_CANONICAL_ORIGIN=https://dinh-duong-aura.vercel.app
OPENROUTER_VISION_FALLBACK_MODEL=google/gemini-3.6-flash
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Keep deferred while App Check is monitor-only. Set to immediate before any
# callable uses ENFORCE_APP_CHECK=true or ENFORCE_AI_APP_CHECK=true.
VITE_APP_CHECK_INITIALIZATION=deferred
VITE_FIREBASE_APP_ID=
VITE_APP_RELEASE=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GOOGLE_MAPS_API_KEY=
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_DEMO_OTP=false
VITE_FIREBASE_VAPID_KEY=
VITE_ENABLE_OFFLINE_CACHE=false
OPENROUTER_API_KEY=
# Store GOOGLE_MAPS_API_KEY in Firebase Secret Manager for Functions.
GOOGLE_MAPS_API_KEY=
# 32+ character server-only secret used to derive one-time delivery OTPs.
DELIVERY_OTP_SECRET=
# Server secrets are bound explicitly by each Firebase Function. Do not put
# production secret values in this frontend environment file.
